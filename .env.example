# ============================================================
# Backend Environment Variables  (copy to server/.env)
# ============================================================
MONGODB_URI=mongodb://localhost:27017/primemart
JWT_SECRET=replace_with_a_long_random_secret
PORT=5000
NODE_ENV=development

# Comma-separated origins allowed to call the API
# Add your GitHub Pages URL here for production
FRONTEND_URLS=http://localhost:5173,https://harikrishnan200612.github.io

# ============================================================
# Frontend Environment Variables  (copy to client/.env.local)
# ============================================================
# Points the dev-server proxy at your local backend.
# In production this is set as a GitHub Actions repository variable
# (Settings → Secrets and variables → Actions → Variables → VITE_API_URL)
VITE_API_URL=http://localhost:5000
